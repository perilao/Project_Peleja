[sub_resource type="GDScript" id="GDScript_esggg"]
script/source = "extends RigidBody3D

@export var item_type: String = \"\"
@export var uses: int = 3
var was_used := false
@export var move_horizontal: bool = false
@onready var label: Label3D = get_node_or_null(\"Label3D\")
@onready var player: CharacterBody3D = $\"../../../Player\"
@export var current_player_speed = 0
var original_player_speed: float = 0.0

func _ready():
	original_player_speed = player.SPEED
	update_label()

func use_item():
	if uses <= 0:
		return
	uses -= 1
	was_used = true
	update_label()
	if move_horizontal:
		original_player_speed = player.SPEED
		player.SPEED = current_player_speed
		player.axis_lock_linear_z = true
	print(\"Usos:\", uses)

func return_use():
	uses += 1
	was_used = false
	update_label()
	if move_horizontal:
		player.SPEED = original_player_speed
		player.axis_lock_linear_z = false
	print(\"Usos:\", uses)

func update_label():
	if label != null:
		label.text = str(uses)
"

