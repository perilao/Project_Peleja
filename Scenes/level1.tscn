[sub_resource type="GDScript" id="GDScript_esggg"]
script/source = "extends RigidBody3D

#ITEM PROPERTIES
@export var item_type: String = \"\"
@export var uses: int = 3
@onready var label: Label3D = get_node_or_null(\"Label3D\")
var was_used := false

#PLAYER REFERENCES
@onready var player: CharacterBody3D = $\"../../../Player\"
@export var current_player_speed = 0
@export var move_horizontal: bool = false
var original_player_speed: float = 0.0

#OUTLINE SHADERS
@export var mesh: MeshInstance3D
@export var outline_material: Material

func _ready():
	original_player_speed = player.SPEED
	update_label()

func use_item():
	#USE ITEM LABEL LOGIC
	if uses <= 0:
		return
	uses -= 1
	was_used = true
	update_label()
	print(\"Usos:\", uses)

func return_use():
	#RETURN ITEM AND ADD COUNTER
	uses += 1
	was_used = false
	update_label()
	print(\"Usos:\", uses)

func update_label():
	#UPDATE THE COUNTER
	if label != null:
		label.text = str(uses)

#LOCK PLAYER MOVEMENT LOGIC
func lock_move_z():
	if move_horizontal:
		original_player_speed = player.SPEED
		player.SPEED = current_player_speed
		player.axis_lock_linear_z = true
func release_move_z():
	if move_horizontal:
		player.SPEED = original_player_speed
		player.axis_lock_linear_z = false


func _on_areaitem_2_area_entered(_area: Area3D) -> void:
	mesh.material_overlay = outline_material


func _on_areaitem_2_area_exited(_area: Area3D) -> void:
	mesh.material_overlay = null
"

