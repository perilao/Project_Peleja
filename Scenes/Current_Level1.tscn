#ITEM PROPERTIES
@export var item_type: String = \"\"
@export var uses: int = 3
@onready var label: Label3D = get_node_or_null(\"Label3D\")
var was_used := false
var release_distance = 2
var original_position: Vector3
#PLAYER REFERENCES
@onready var player: CharacterBody3D = $\"../../../Player\"
@export var current_player_speed = 0
@export var move_horizontal: bool = false
var original_player_speed: float = 0.0
var locked_rotation_y: float
@onready var animation: AnimationPlayer = $AnimationPlayer


#OUTLINE SHADERS
@export var mesh: MeshInstance3D
@export var outline_material: Material

#PUSH PROPERTIES
@onready var push_position: Marker3D = $push_position
@onready var target_position: Marker3D = $\"../../../Events/Event_Test3/target_position\"
@export var push_speed: float = 3.0
var is_being_pushed := false
var push_complete := false
var original_x: float
var original_y: float
var original_z: float
var push_offset_x: float  
@onready var timer_geral: Timer = $\"../../../Events/Event_Test3/timer_geral\"
var is_returning := false
var return_speed: float = 1.0
@export var return_time: float = 35.0
@onready var evento: StaticBody3D = %Event_Test3
@export var return_start_time: float = 40.0
@export var return_duration: float = 10.0
var is_destroying := false

func _ready():
	freeze = true
	lock_rotation = true
	original_position = global_position
	original_x = global_position.x
	original_y = global_position.y
	original_z = global_position.z
	update_label()
	await get_tree().process_frame
	global_position.x = target_position.global_position.x
	push_complete = true

func _input(event):
	if event.is_action_pressed(\"ui_grab\"):
		if is_being_pushed:
			cancel_push()
			get_viewport().set_input_as_handled()
func _physics_process(delta):
	if is_being_pushed and !push_complete:
		global_position.z = original_z
		global_position.y = original_y
		global_position.x = player.global_position.x + push_offset_x
		var diference = abs(global_position.x - target_position.global_position.x)
		if diference < 0.3:
			push_complete = true
			finish_push()
	if is_returning:
		var target = Vector3(original_x, original_y, original_z)
		global_position = global_position.move_toward(target, return_speed * delta)
		global_position.y = original_y
		if global_position.distance_to(target) < 0.1 and !is_destroying:
			is_returning = false
			freeze = true
			push_complete = false
			player.cant_grab = false
			if uses <= 0: 
				is_destroying = true
				await get_tree().process_frame
				queue_free()
		
func _process(_delta):
	if push_complete and !is_returning:
		if timer_geral.time_left <= return_start_time and timer_geral.time_left > evento.event_time:
			start_return()
	if uses <= 3:
		animation.play(\"wardrobe_breaking\")
		
func start_return():
	is_returning = true
	freeze = false
	lock_rotation = true
	if player:
		player.cant_grab = false 
	
	var distance = abs(global_position.x - original_x)
	return_speed = distance / return_duration

func start_push():
	if is_being_pushed:
		return
	if uses <= 0:
		return
	if push_complete and !is_returning:
		return
	if uses <= 1 and is_returning:
		return
	is_returning = false
	push_complete = false
	is_being_pushed = true
	freeze = false
	lock_rotation = true
	push_offset_x = global_position.x - push_position.global_position.x
	player.global_position = push_position.global_position
	player.axis_lock_linear_z = true
	player.lock_z = true
	original_player_speed = player.SPEED
	player.SPEED = current_player_speed
	player.locked_rotation_y = PI / 2
	player.lock_rotation = true
	player.player_has_item = true

func cancel_push():
	var dist = global_position.distance_to(original_position)
	if dist <= release_distance:
		is_being_pushed = false
		freeze = true 
		if player:
			player.axis_lock_linear_z = false
			player.lock_z = false
			player.SPEED = original_player_speed
			player.lock_rotation = false
			player.player_has_item = false
			player.cant_grab = true
			if \"block_input\" in player:
				player.block_input = false
		global_position = Vector3(original_x, original_y, original_z)
		await get_tree().create_timer(0.2).timeout
		if player:
			player.cant_grab = false
func finish_push():
	is_being_pushed = false
	freeze = false
	player.axis_lock_linear_z = false
	player.block_input = false
	player.lock_z = false
	player.SPEED = original_player_speed
	player.cant_grab = true
	player.lock_rotation = false
	timer_geral.wait_time = evento.original_wait_time
	timer_geral.start()
	evento.mesh.get_active_material(0).albedo_color = evento.Event_Color
	player.player_has_item = false
	use_item()
func use_item():
	#USE ITEM LABEL LOGIC
	if uses <= 0:
		return
	uses -= 1
	was_used = true
	update_label()
	print(\"Usos:\", uses)


func return_use():
	#RETURN ITEM AND ADD COUNTER
	uses += 1
	was_used = false
	update_label()
	print(\"Usos:\", uses)

func update_label():
	#UPDATE THE COUNTER
	if is_destroying:
		return
	if label != null:
		label.text = str(uses)

func _on_areaitem_2_area_entered(area: Area3D) -> void:
	if area == player.player_area:
		mesh.material_overlay = outline_material
func _on_areaitem_2_area_exited(area: Area3D) -> void:
	if area == player.player_area:
		mesh.material_overlay = null
"

