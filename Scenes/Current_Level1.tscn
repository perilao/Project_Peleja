[sub_resource type="GDScript" id="GDScript_cpkqv"]
script/source = "extends RigidBody3D

#OUTLINE SHADERS
@export var mesh: MeshInstance3D
@export var outline_material: Material
#GRAB
var is_held := false
@onready var player: CharacterBody3D = $\"../../../Player\"

func _ready():
	freeze = false
	gravity_scale = 0.0

func set_held(held: bool):
	is_held = held
	if held:
		gravity_scale = 0.0
	else:
		var current_pos = global_position
		gravity_scale = 1.0
		await get_tree().physics_frame
		if linear_velocity.length() < 0.1:
			global_position = current_pos

func _physics_process(_delta):
	if not is_held and not freeze:
		if linear_velocity.length() < 0.1:
			linear_velocity = Vector3.ZERO
			angular_velocity = Vector3.ZERO
			gravity_scale = 10.0

func _on_areaitem_3_3_area_entered(area: Area3D) -> void:
	if area == player.player_area:
		mesh.material_overlay = outline_material

func _on_areaitem_3_3_area_exited(area: Area3D) -> void:
	if area == player.player_area:
		mesh.material_overlay = null
"

