[sub_resource type="GDScript" id="GDScript_tlxhh"]
script/source = "extends RigidBody3D

#ITEM PROPERTIES
@export var item_type: String = \"\"
@export var uses: int = 3
@onready var label: Label3D = get_node_or_null(\"Label3D\")
var was_used := false

#OUTLINE SHADERS
@export var mesh: MeshInstance3D
@export var outline_material: Material

func _ready():
	update_label()

func use_item():
	#USE ITEM LABEL LOGIC
	if uses <= 0:
		return
	uses -= 1
	was_used = true
	update_label()
	print(\"Usos:\", uses)

func return_use():
	#RETURN ITEM AND ADD COUNTER
	uses += 1
	was_used = false
	update_label()
	print(\"Usos:\", uses)

func update_label():
	#UPDATE THE COUNTER
	if label != null:
		label.text = str(uses)


func _on_areaitem_3_1_area_entered(_area: Area3D) -> void:
	mesh.material_overlay = outline_material

func _on_areaitem_3_1_area_exited(_area: Area3D) -> void:
	mesh.material_overlay = null
"

